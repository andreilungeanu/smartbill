# Composer
# This is a library: do not commit the lockfile. CI runs `composer update`.
composer.lock
composer.phar
/vendor
auth.json

# Secrets / local environment
# A .env in the package root would hold SMARTBILL_API_* credentials.
.env
.env.*
!.env.example

# Frontend leftovers (this package has no JS; keep in case assets are added)
/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log
pnpm-debug.log*

# PHPUnit / PHPStan artefacts
# phpunit.xml.dist -> cacheDirectory=".phpunit.cache", junit -> build/
# phpstan.neon.dist -> tmpDir: build/phpstan
.phpunit.cache
.phpunit.result.cache
phpunit.xml.dist.bak
/build
/coverage

# Local overrides of committed *.dist files
phpunit.xml
phpstan.neon

# Orchestra Testbench (generated workbench; composer.json autoloads it)
testbench.yaml
/@testbench
/workbench

# Laravel IDE Helper / Phpactor (if generated while developing the package)
_ide_helper.php
_ide_helper_models.php
.phpstorm.meta.php
.phpactor.json

# Editors and AI tooling
/.idea
/.fleet
/.vscode
/.nova
/.zed
/.cursor
/.claude
/.kilo
/.codex
/.agents
/.zcode

# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# Local scratch
/docs
/scripts
/CLAUDE.md
