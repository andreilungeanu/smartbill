# Path-based git attributes
# https://www.kernel.org/pub/software/scm/git/docs/gitattributes.html

# Line endings — keep the repo LF even on Windows checkouts
* text=auto eol=lf

*.php text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.neon text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files - don't touch
*.png binary
*.jpg binary
*.pdf binary

# Exclude development-only files from dist archives (`composer archive` / Packagist)
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/phpunit.xml.dist   export-ignore
/docs               export-ignore
/tests              export-ignore
/workbench          export-ignore
/.editorconfig      export-ignore
/testbench.yaml     export-ignore
/CLAUDE.md          export-ignore
/pint.json          export-ignore
/phpstan.neon.dist  export-ignore
/phpstan-baseline.neon  export-ignore
/scripts            export-ignore
# Stale transcription: still shows create() and 19% VAT. The OpenAPI spec at
# api.smartbill.ro is the contract; keep this on GitHub, out of the dist.
/DOCUMENTATION.md   export-ignore
